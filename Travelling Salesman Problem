
n = int(input("Enter number of cities: "))

cost = []
print("Enter cost matrix (999 for no path):")

for i in range(n):
    cost.append(list(map(int, input().split())))

dp = [[999] * n for _ in range(1 << n)]
dp[1][0] = 0

for mask in range(1 << n):
    for u in range(n):
        if mask & (1 << u):
            for v in range(n):
                if not mask & (1 << v):
                    new_mask = mask | (1 << v)
                    dp[new_mask][v] = min(
                        dp[new_mask][v],
                        dp[mask][u] + cost[u][v]
                    )

ans = min(dp[(1 << n) - 1][i] + cost[i][0]
          for i in range(n))

print("Minimum travelling cost =", ans)
